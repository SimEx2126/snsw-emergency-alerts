# SNSW Emergency Monitor — environment configuration
# Copy to .env and fill in. IMPORTANT: the env parser does NOT strip inline
# comments — keep values on their own line with nothing after them.

# NASA FIRMS satellite fire detection (free key, instant email signup)
# https://firms.modaps.eosdis.nasa.gov/api/area/
FIRMS_MAP_KEY=

# Email alerts (SMTP)
# For Microsoft 365 / Google Workspace, SMTP AUTH may be disabled by the
# tenant. If npm run test:alert fails, use an SMTP relay (SMTP2GO, Postmark).
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
ALERT_EMAIL_FROM=
# Comma-separated recipient list
ALERT_EMAIL_TO=

# Monitored region (defaults: southern NSW + ACT)
# REGION_WEST=141.0
# REGION_SOUTH=-37.6
# REGION_EAST=151.7
# REGION_NORTH=-34.0
# REGION_LABEL=Southern NSW & ACT

# Sweep cadence in minutes (5 recommended during fire/flood season)
REFRESH_INTERVAL_MINUTES=5

# Server
PORT=3117
# Public URL used in alert emails' dashboard link (falls back to localhost)
# PUBLIC_URL=

# BOM tuning: set to "on" to filter warnings to southern-NSW/ACT forecast
# districts once tuned against a real warning cycle
BOM_DISTRICT_FILTER=off

# Drill mode: point the RFS source at a fixture URL to rehearse the full
# sweep -> detection -> email chain (see README "Running a drill")
# RFS_FEED_URL=

# Optional dormant transports (inherited from Crucix)
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=
# DISCORD_WEBHOOK_URL=

# Optional LLM alert evaluation (system is fully functional without one)
# LLM_PROVIDER=anthropic
# LLM_API_KEY=
# LLM_MODEL=claude-sonnet-5
